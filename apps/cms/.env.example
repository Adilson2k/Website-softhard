# Firebase Web API key is public configuration used by Firebase Authentication.
VITE_FIREBASE_API_KEY=replace-with-softhard-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=softhard-57d83.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=softhard-57d83
VITE_FIREBASE_APP_ID=replace-with-softhard-web-app-id

# Same-origin /api is proxied to the Express API in local development.
VITE_API_URL=/api
