{
  "name": "website-institucional",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,cms,api \"npm run dev --workspace=web\" \"npm run dev --workspace=softhard-cms\" \"npm run dev --workspace=api\"",
    "dev:web": "npm run dev --workspace=web",
    "dev:cms": "npm run dev --workspace=softhard-cms",
    "dev:api": "npm run dev --workspace=api",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
